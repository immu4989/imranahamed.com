---
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  tags?: string[];
  readingMinutes?: number;
  featured?: boolean;
}
const {
  title,
  description,
  pubDate,
  href,
  tags = [],
  readingMinutes,
  featured = false,
} = Astro.props;
---

<article class="card group mb-5">
  <div class="flex items-baseline justify-between gap-4 mb-1 flex-wrap">
    <div class="flex items-baseline gap-2 flex-wrap">
      {featured && (
        <span class="text-[10.5px] uppercase tracking-wider font-mono font-medium text-white px-2 py-[2px] rounded-full" style="background: var(--gradient-brand);">
          Featured
        </span>
      )}
      <h3 class="text-[19px] font-display font-semibold tracking-tight leading-snug">
        <a
          href={href}
          class="text-[color:var(--color-ink)] no-underline hover:no-underline group-hover:text-[color:var(--color-brand-vivid)] transition-colors"
        >
          {title}
        </a>
      </h3>
    </div>
  </div>
  <p class="text-[15.5px] text-[color:var(--color-ink-muted)] leading-snug mt-1.5">
    {description}
  </p>
  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
    <FormattedDate date={pubDate} />
    {readingMinutes && (
      <>
        <span class="text-[color:var(--color-ink-faint)] text-[13px]">·</span>
        <span class="text-[13px] text-[color:var(--color-ink-muted)]">{readingMinutes} min read</span>
      </>
    )}
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <Tag tag={t} href={`/writing/tag/${t}/`} />
          ))}
        </div>
      )
    }
  </div>
</article>
