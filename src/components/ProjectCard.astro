---
import Tag from './Tag.astro';

interface Props {
  title: string;
  description: string;
  role?: string;
  stack?: string[];
  status?: 'active' | 'shipped' | 'archived';
  href: string;
  externalLink?: string;
  featured?: boolean;
}
const {
  title,
  description,
  role,
  stack = [],
  status = 'shipped',
  href,
  externalLink,
  featured = false,
} = Astro.props;

const statusConfig = {
  active:   { label: 'Active',   color: '#10b981' },
  shipped:  { label: 'Shipped',  color: '#94a3b8' },
  archived: { label: 'Archived', color: '#a8a29e' },
}[status];
---

<article class="group py-6 border-b border-[var(--color-rule)] last:border-0">
  <div class="flex items-baseline justify-between gap-4 mb-1 flex-wrap">
    <div class="flex items-baseline gap-2 flex-wrap">
      <span
        class="inline-flex items-center gap-1.5 text-[10.5px] uppercase tracking-wider font-mono"
        style={`color: ${statusConfig.color};`}
      >
        <span
          class="inline-block w-1.5 h-1.5 rounded-full"
          style={`background: ${statusConfig.color};`}
        ></span>
        {statusConfig.label}
      </span>
      {featured && (
        <span class="text-[10.5px] uppercase tracking-wider font-mono text-[color:var(--color-accent)] bg-[color:var(--color-accent-soft)] px-1.5 py-[1px] rounded">
          Featured
        </span>
      )}
    </div>
    {role && <span class="text-[12.5px] text-[color:var(--color-ink-faint)] font-mono">{role}</span>}
  </div>

  <h3 class="text-[19px] font-semibold tracking-tight leading-snug mt-1">
    <a
      href={href}
      class="text-[color:var(--color-ink)] no-underline hover:no-underline group-hover:text-[color:var(--color-accent)]"
    >
      {title}
    </a>
  </h3>

  <p class="text-[15.5px] text-[color:var(--color-ink-muted)] leading-snug mt-1.5">
    {description}
  </p>

  <div class="mt-3 flex items-center justify-between flex-wrap gap-y-2 gap-x-3">
    {
      stack.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {stack.map((tech) => (
            <Tag tag={tech} />
          ))}
        </div>
      )
    }
    {
      externalLink && (
        <a
          href={externalLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] font-mono text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)]"
        >
          {externalLink.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗
        </a>
      )
    }
  </div>
</article>
