---
import { NAV, SITE } from '../consts.ts';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}

const navItems = NAV.filter((item) => item.href !== '/');
---

<header class="border-b border-[var(--color-rule)] backdrop-blur-lg sticky top-0 z-20" style="background: color-mix(in oklab, var(--color-paper) 78%, transparent);">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="font-display font-semibold tracking-tight text-[color:var(--color-ink)] no-underline hover:no-underline text-[16px] flex items-center gap-2"
    >
      <span
        class="inline-block w-2.5 h-2.5 rounded-full"
        style="background: var(--gradient-brand);"
        aria-hidden="true"
      ></span>
      {SITE.title}
    </a>
    <nav class="flex gap-x-4 sm:gap-x-5 text-[14px]">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'no-underline hover:no-underline transition-colors',
              isActive(item.href)
                ? 'text-[color:var(--color-brand-vivid)] font-medium'
                : 'text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
