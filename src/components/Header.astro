---
import { NAV, SITE } from '../consts.ts';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}

const navItems = NAV.filter((item) => item.href !== '/');
---

<header class="border-b border-[var(--color-rule)] backdrop-blur-md sticky top-0 z-10 bg-[color:var(--color-paper)]/85">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="font-semibold tracking-tight text-[color:var(--color-ink)] no-underline hover:no-underline text-[15px]"
    >
      {SITE.title}
    </a>
    <nav class="flex gap-x-5 text-[14px]">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'no-underline hover:no-underline',
              isActive(item.href)
                ? 'text-[color:var(--color-ink)] font-medium'
                : 'text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
