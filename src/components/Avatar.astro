---
import { SITE } from '../consts.ts';

interface Props {
  size?: number;
}
const { size = 64 } = Astro.props;
---

<div
  class="rounded-full bg-[color:var(--color-paper-tint)] border border-[var(--color-rule)] flex items-center justify-center font-mono font-medium text-[color:var(--color-ink-muted)] shrink-0 select-none"
  style={`width: ${size}px; height: ${size}px; font-size: ${Math.round(size * 0.34)}px;`}
  aria-label={SITE.author}
>
  {SITE.initials}
</div>
