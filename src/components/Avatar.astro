---
import { SITE } from '../consts.ts';

interface Props {
  size?: number;
  src?: string;
  alt?: string;
}
const { size = 64, src = '/avatar.jpg', alt = SITE.author } = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      width={size}
      height={size}
      loading="eager"
      decoding="async"
      class="rounded-full object-cover border border-[var(--color-rule)] shrink-0 select-none"
      style={`width: ${size}px; height: ${size}px;`}
    />
  ) : (
    <div
      class="rounded-full bg-[color:var(--color-paper-tint)] border border-[var(--color-rule)] flex items-center justify-center font-mono font-medium text-[color:var(--color-ink-muted)] shrink-0 select-none"
      style={`width: ${size}px; height: ${size}px; font-size: ${Math.round(size * 0.34)}px;`}
      aria-label={alt}
    >
      {SITE.initials}
    </div>
  )
}
