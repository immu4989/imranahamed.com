---
import { SITE, SOCIAL } from '../consts.ts';
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] mt-24">
  <div class="mx-auto max-w-3xl px-6 py-10 text-[14px] text-[color:var(--color-ink-muted)] flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>© {year} {SITE.author}</div>
    <div class="flex gap-4">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer">Scholar</a>
      <a href="/rss.xml">RSS</a>
      <a href={SOCIAL.email}>Email</a>
    </div>
  </div>
</footer>
