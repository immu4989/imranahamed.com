---
import { SITE, SOCIAL } from '../consts.ts';
const year = new Date().getFullYear();

const links = [
  { href: SOCIAL.github, label: 'GitHub' },
  { href: SOCIAL.linkedin, label: 'LinkedIn' },
  { href: SOCIAL.scholar, label: 'Scholar' },
  { href: SOCIAL.substack, label: 'Substack' },
  { href: '/rss.xml', label: 'RSS' },
  { href: SOCIAL.email, label: 'Email' },
].filter((l) => Boolean(l.href));
---

<footer class="mt-24 border-t border-[var(--color-rule)] bg-[color:var(--color-paper-muted)]">
  <div class="mx-auto max-w-4xl px-6 py-10 text-[14px] text-[color:var(--color-ink-muted)]">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <div class="font-display font-semibold text-[color:var(--color-ink)] text-[15px] flex items-center gap-2">
          <span
            class="inline-block w-2 h-2 rounded-full"
            style="background: var(--gradient-brand);"
            aria-hidden="true"
          ></span>
          {SITE.author}
        </div>
        <p class="mt-1 max-w-md">Applied AI/ML. Multi-agent systems, RAG, and open-source ML infrastructure.</p>
      </div>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="hover:text-[color:var(--color-brand-vivid)]"
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="mt-6 pt-4 border-t border-[var(--color-rule)] text-[12px] text-[color:var(--color-ink-faint)]">
      © {year} {SITE.author} · Built with Astro
    </div>
  </div>
</footer>
