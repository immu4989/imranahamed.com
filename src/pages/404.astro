---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="py-12">
    <p class="font-mono text-[14px] text-[color:var(--color-ink-muted)]">404</p>
    <h1 class="mt-2 text-[34px] font-semibold tracking-tight">Not found</h1>
    <p class="mt-4 text-[17px] text-[color:var(--color-ink-muted)]">
      That page isn&rsquo;t here. Try <a href="/">home</a>, <a href="/writing">writing</a>, or
      <a href="/projects">projects</a>.
    </p>
  </section>
</BaseLayout>
