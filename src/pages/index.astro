---
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Avatar from '../components/Avatar.astro';
import StatLine from '../components/StatLine.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import RepoMarquee from '../components/RepoMarquee.astro';
import { getCollection } from 'astro:content';
import { SOCIAL, CONTRIBUTIONS, SECURITY_WORK } from '../consts.ts';
import { readingTime } from '../utils/reading-time.ts';

const essays = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const totalMerged = CONTRIBUTIONS.reduce(
  (n, p) => n + p.prs.filter((pr) => pr.status === 'merged').length,
  0,
);
const totalOpen = CONTRIBUTIONS.reduce(
  (n, p) => n + p.prs.filter((pr) => pr.status === 'open').length,
  0,
);
---

<BaseLayout wide>
  {/* HERO */}
  <section class="relative pt-6 pb-10 -mx-6 sm:mx-0 sm:rounded-3xl px-6 sm:px-10 py-10" style="background: var(--gradient-hero); border-radius: 1.5rem;">
    <div class="flex flex-col sm:flex-row items-start gap-6">
      <Avatar size={104} />
      <div class="flex-1 min-w-0">
        <span class="inline-flex items-center gap-2 text-[12px] font-mono uppercase tracking-wider text-[color:var(--color-brand-vivid)] bg-[color:var(--color-brand-soft)] px-3 py-1 rounded-full">
          <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: var(--color-accent-3);"></span>
          Available for select advisory
        </span>
        <h1 class="mt-4 text-[44px] sm:text-[56px] font-display font-bold tracking-tight leading-[1.02]">
          Hi, I&rsquo;m <span class="text-gradient">Imran</span>.
        </h1>
        <p class="mt-4 text-[19px] text-[color:var(--color-ink-muted)] leading-relaxed max-w-[65ch]">
          I build applied AI/ML systems. Currently co-founding
          <a href={SOCIAL.vezran} target="_blank" rel="noopener noreferrer">VEZRAN</a> —
          shipping <a href={SOCIAL.zyberpol} target="_blank" rel="noopener noreferrer">Zyberpol</a>,
          an agentic Security Operations Center platform. Previously Senior Data Scientist at
          Starbucks and FedEx.
        </p>
        <p class="mt-3 text-[17px] text-[color:var(--color-ink-muted)] leading-relaxed max-w-[65ch]">
          I write about production ML, contribute to open-source AI infrastructure, and disclose
          security research to the projects I depend on.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/writing" class="btn-primary">Read the writing →</a>
          <a href="/contributions" class="btn-secondary">See {totalMerged}+ merged PRs</a>
        </div>
      </div>
    </div>

    <StatLine />
  </section>

  {/* WRITING */}
  <section class="mt-16 mb-14">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-[13px] font-mono uppercase tracking-wider text-[color:var(--color-brand-vivid)]">
        <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background: var(--gradient-brand);"></span>
        Writing &mdash; long-form essays
      </h2>
      <a href="/writing" class="text-[13px] font-mono text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-vivid)]">all →</a>
    </div>
    {
      essays.length === 0 ? (
        <p class="text-[color:var(--color-ink-muted)] py-4">No essays yet.</p>
      ) : (
        essays.map((essay) => {
          const { minutes } = readingTime(essay.body);
          return (
            <EssayCard
              title={essay.data.title}
              description={essay.data.description}
              pubDate={essay.data.pubDate}
              href={`/writing/${essay.id}/`}
              tags={essay.data.tags}
              readingMinutes={minutes}
              featured={essay.data.featured}
            />
          );
        })
      )
    }
  </section>

  {/* OSS SPOTLIGHT */}
  <section class="mb-14">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-[13px] font-mono uppercase tracking-wider" style="color: var(--color-accent-1);">
        <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background: var(--color-accent-1);"></span>
        Open source &mdash; {totalMerged} merged PRs, {totalOpen} open
      </h2>
      <a href="/contributions" class="text-[13px] font-mono text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-vivid)]">all →</a>
    </div>
    <RepoMarquee />
  </section>

  {/* SECURITY */}
  {SECURITY_WORK.length > 0 && (
    <section class="mb-14">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-[13px] font-mono uppercase tracking-wider" style="color: var(--color-accent-2);">
          <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background: var(--color-accent-2);"></span>
          Security research
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {SECURITY_WORK.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card block no-underline hover:no-underline"
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[11px] font-mono uppercase tracking-wider" style="color: var(--color-accent-2);">
                {item.kind}
              </span>
              <span class="text-[11px] font-mono text-[color:var(--color-ink-faint)]">{item.date}</span>
            </div>
            <h3 class="mt-2 text-[16px] font-display font-semibold text-[color:var(--color-ink)]">
              {item.title}
            </h3>
            <p class="mt-1 text-[13.5px] text-[color:var(--color-ink-muted)] leading-snug">
              {item.summary}
            </p>
            <p class="mt-2 text-[12px] font-mono text-[color:var(--color-ink-faint)]">
              {item.id} · {item.org}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* NOTES */}
  <section class="mb-14">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-[13px] font-mono uppercase tracking-wider" style="color: var(--color-accent-4);">
        <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background: var(--color-accent-4);"></span>
        Notes &mdash; short-form
      </h2>
      <a href="/notes" class="text-[13px] font-mono text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-vivid)]">all →</a>
    </div>
    {
      notes.length === 0 ? (
        <p class="text-[color:var(--color-ink-muted)] py-4">No notes yet.</p>
      ) : (
        <div class="card">
          <ul class="divide-y divide-[var(--color-rule)]">
            {notes.map((note) => (
              <li class="py-3 flex items-baseline justify-between gap-4">
                <a
                  href={`/notes/${note.id}/`}
                  class="text-[15.5px] text-[color:var(--color-ink)] no-underline hover:text-[color:var(--color-brand-vivid)] hover:no-underline flex-1 min-w-0"
                >
                  {note.data.title}
                </a>
                <FormattedDate date={note.data.pubDate} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  {/* PROJECTS */}
  <section class="mb-14">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-[13px] font-mono uppercase tracking-wider" style="color: var(--color-accent-5);">
        <span class="inline-block w-6 h-[2px] mr-2 align-middle" style="background: var(--color-accent-5);"></span>
        Projects
      </h2>
      <a href="/projects" class="text-[13px] font-mono text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-vivid)]">all →</a>
    </div>
    {
      projects.length === 0 ? (
        <p class="text-[color:var(--color-ink-muted)] py-4">No projects yet.</p>
      ) : (
        projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            role={project.data.role}
            stack={project.data.stack}
            status={project.data.status}
            href={`/projects/${project.id}/`}
            externalLink={project.data.link}
            featured={project.data.featured}
          />
        ))
      )
    }
  </section>

  {/* NEWSLETTER */}
  <section class="card-gradient mt-16">
    <div>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div class="flex-1">
          <h2 class="text-[24px] font-display font-semibold tracking-tight">Get the newsletter</h2>
          <p class="mt-2 text-[15.5px] text-[color:var(--color-ink-muted)] leading-relaxed max-w-[52ch]">
            Field notes on applied AI &mdash; agent eval, RAG in production, OSS finds, what the
            demos leave out. One essay every couple of weeks. No spam.
          </p>
        </div>
        <div class="sm:w-auto">
          <NewsletterForm compact />
        </div>
      </div>
    </div>
  </section>

  {/* ELSEWHERE */}
  <section class="mt-16">
    <h2 class="text-[13px] font-mono uppercase tracking-wider text-[color:var(--color-ink-muted)] mb-4">
      Elsewhere on the web
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="card !p-3 flex items-center justify-between no-underline hover:no-underline">
        <span class="font-mono text-[13.5px] text-[color:var(--color-ink)]">GitHub</span>
        <span class="text-[color:var(--color-brand-vivid)] text-[12px]">↗</span>
      </a>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="card !p-3 flex items-center justify-between no-underline hover:no-underline">
        <span class="font-mono text-[13.5px] text-[color:var(--color-ink)]">LinkedIn</span>
        <span class="text-[color:var(--color-brand-vivid)] text-[12px]">↗</span>
      </a>
      <a href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer" class="card !p-3 flex items-center justify-between no-underline hover:no-underline">
        <span class="font-mono text-[13.5px] text-[color:var(--color-ink)]">Google Scholar</span>
        <span class="text-[color:var(--color-brand-vivid)] text-[12px]">↗</span>
      </a>
      <a href={SOCIAL.substack} target="_blank" rel="noopener noreferrer" class="card !p-3 flex items-center justify-between no-underline hover:no-underline">
        <span class="font-mono text-[13.5px] text-[color:var(--color-ink)]">Substack</span>
        <span class="text-[color:var(--color-brand-vivid)] text-[12px]">↗</span>
      </a>
    </div>
    <p class="mt-3 text-[12px] text-[color:var(--color-ink-faint)] font-mono">
      TODO: add X, HuggingFace, Medium, HackerNoon once profiles exist
    </p>
  </section>
</BaseLayout>
