---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Notes"
  description="Short-form notes — bookmarks, snippets, work-in-progress thinking."
>
  <header class="mb-8">
    <h1 class="text-[40px] font-semibold tracking-tight">Notes</h1>
    <p class="mt-3 text-[17px] text-[color:var(--color-ink-muted)] leading-relaxed max-w-[60ch]">
      Short-form thinking — bookmarks, snippets, half-formed ideas. Long-form lives on
      <a href="/writing">writing</a>.
    </p>
  </header>

  {
    notes.length === 0 ? (
      <p class="text-[color:var(--color-ink-muted)]">No notes yet.</p>
    ) : (
      <ul class="divide-y divide-[var(--color-rule)]">
        {notes.map((note) => (
          <li class="py-4">
            <div class="flex items-baseline justify-between gap-4 mb-1">
              <a
                href={`/notes/${note.id}/`}
                class="text-[17px] font-medium text-[color:var(--color-ink)] no-underline hover:text-[color:var(--color-accent)] hover:no-underline"
              >
                {note.data.title}
              </a>
              <FormattedDate date={note.data.pubDate} />
            </div>
            {note.data.description && (
              <p class="text-[14.5px] text-[color:var(--color-ink-muted)] leading-snug">
                {note.data.description}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
