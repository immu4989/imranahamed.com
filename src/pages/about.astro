---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { SOCIAL } from '../consts.ts';
---

<BaseLayout
  title="About"
  description="Imran Ahamed — applied AI/ML engineer, co-founder at VEZRAN, ex-Starbucks, ex-FedEx."
>
  <header class="flex flex-col sm:flex-row items-start gap-6 mb-10 p-6 sm:p-8 rounded-3xl" style="background: var(--gradient-hero);">
    <Avatar size={104} />
    <div class="flex-1 min-w-0">
      <span class="inline-flex items-center gap-2 text-[12px] font-mono uppercase tracking-wider text-[color:var(--color-brand-vivid)] bg-[color:var(--color-brand-soft)] px-3 py-1 rounded-full">
        About
      </span>
      <h1 class="mt-3 text-[42px] font-display font-bold tracking-tight leading-[1.05]">
        Applied AI/ML engineer.
      </h1>
      <p class="mt-3 text-[17px] text-[color:var(--color-ink-muted)]">
        Currently co-founding VEZRAN. Based in Richardson, TX.
      </p>
    </div>
  </header>

  <article class="prose-essay">
    <p>
      I build applied AI/ML systems. Started in 2014 on banking data engineering at TCS;
      the last 8+ years have been production ML &mdash; first at FedEx, then Starbucks,
      now co-founding <a href={SOCIAL.vezran} target="_blank" rel="noopener noreferrer">VEZRAN</a>.
    </p>

    <h2>What I focus on</h2>
    <p>
      Multi-agent systems and RAG pipelines that survive contact with production. Agent
      orchestration on frontier LLMs (Claude, GPT-4o, Gemini), eval design when ground
      truth is incomplete, and the unglamorous infrastructure &mdash; latency, cost,
      fallback paths &mdash; that decides whether agents actually ship.
    </p>

    <h2>What I&rsquo;m building now</h2>
    <p>
      Co-founder and Head of AI/ML at <a href={SOCIAL.vezran} target="_blank" rel="noopener noreferrer">VEZRAN</a>.
      We&rsquo;re shipping <a href={SOCIAL.zyberpol} target="_blank" rel="noopener noreferrer">Zyberpol</a>,
      an agentic SOC platform with four working agents &mdash; Correlation, Investigation, Triage,
      Remediation &mdash; sitting on top of CrowdStrike, Okta, Splunk, and AWS. The differentiator:
      signed, audit-ready evidence for every action. Pre-seed, hiring.
    </p>

    <h2>Open source</h2>
    <p>
      I contribute to the ML/AI infrastructure I depend on &mdash; sustained engagement on a handful
      of projects rather than scattered PRs. Recent focus:
      causal inference (<a href="https://github.com/py-why/dowhy" target="_blank" rel="noopener noreferrer">dowhy</a>,
      <a href="https://github.com/py-why/EconML" target="_blank" rel="noopener noreferrer">EconML</a>),
      AutoML (<a href="https://github.com/microsoft/FLAML" target="_blank" rel="noopener noreferrer">FLAML</a>),
      conformal prediction (<a href="https://github.com/scikit-learn-contrib/MAPIE" target="_blank" rel="noopener noreferrer">MAPIE</a>),
      interpretability (<a href="https://github.com/MAIF/shapash" target="_blank" rel="noopener noreferrer">Shapash</a>),
      LLM red-teaming (<a href="https://github.com/microsoft/PyRIT" target="_blank" rel="noopener noreferrer">PyRIT</a>),
      fairness (<a href="https://github.com/fairlearn/fairlearn" target="_blank" rel="noopener noreferrer">fairlearn</a>),
      and MLOps (<a href="https://github.com/mlflow/mlflow" target="_blank" rel="noopener noreferrer">mlflow</a>).
      Full list on the <a href="/contributions">contributions</a> page.
    </p>

    <h2>What I shipped before</h2>
    <ul>
      <li>
        <strong>Starbucks &mdash; Senior Data Scientist, People Analytics (2022&ndash;2025).</strong>
        Turnover prediction and headcount forecasting models across the US retail footprint.
        BERT/T5 NLP on contact-center data: topic modeling, summarization, semantic search.
      </li>
      <li>
        <strong>FedEx &mdash; Senior Data Scientist (2018&ndash;2022).</strong>
        Package-at-risk and loss-intensity models in production on Azure across the logistics
        network. GDPR-compliant data matching at 95% retrieval. Fraud detection across
        shipping patterns.
      </li>
      <li>
        <strong>TCS &mdash; Systems / Data Engineer (2011&ndash;2014).</strong>
        Banking application engineering and automation work in Bengaluru.
      </li>
    </ul>

    <h2>Stack</h2>
    <p>
      Python, PyTorch, Transformers, LangChain / LangGraph, Azure ML, Databricks, MLflow,
      Ragas, Phoenix, Tableau.
    </p>

    <h2>Education</h2>
    <ul>
      <li>MS, Business Analytics &mdash; The University of Texas at Dallas (2016&ndash;2017)</li>
      <li>BE, Information Science &amp; Engineering &mdash; NMAM Institute of Technology, NITTE (2007&ndash;2011)</li>
    </ul>

    <h2>Elsewhere</h2>
    <ul>
      <li><a href={SOCIAL.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={SOCIAL.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a></li>
      <li><a href={SOCIAL.substack} target="_blank" rel="noopener noreferrer">Substack newsletter</a></li>
      <li><a href={SOCIAL.email}>Email</a></li>
    </ul>
  </article>
</BaseLayout>
