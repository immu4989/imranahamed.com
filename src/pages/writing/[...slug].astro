---
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';
import { readingTime } from '../../utils/reading-time.ts';

export async function getStaticPaths() {
  const essays = await getCollection('writing', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content, headings } = await render(essay);
const { minutes } = readingTime(essay.body);
---

<EssayLayout
  title={essay.data.title}
  description={essay.data.description}
  pubDate={essay.data.pubDate}
  updatedDate={essay.data.updatedDate}
  tags={essay.data.tags}
  readingMinutes={minutes}
  headings={headings}
>
  <Content />
</EssayLayout>
