---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EssayCard from '../../components/EssayCard.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../utils/reading-time.ts';

const essays = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagCounts = new Map<string, number>();
for (const essay of essays) {
  for (const tag of essay.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Writing"
  description="Essays on applied AI/ML — multi-agent systems, RAG in production, eval design."
>
  <header class="mb-8">
    <h1 class="text-[40px] font-semibold tracking-tight">Writing</h1>
    <p class="mt-3 text-[17px] text-[color:var(--color-ink-muted)] leading-relaxed max-w-[60ch]">
      Field notes on applied AI/ML. What actually ships vs. what demos.
    </p>
  </header>

  {
    sortedTags.length > 0 && (
      <div class="mb-8 flex flex-wrap items-center gap-2">
        <span class="text-[12px] font-mono uppercase tracking-wider text-[color:var(--color-ink-faint)] mr-1">
          Tags:
        </span>
        {sortedTags.map(([tag, count]) => (
          <Tag tag={`${tag} · ${count}`} href={`/writing/tag/${tag}/`} />
        ))}
      </div>
    )
  }

  {
    essays.length === 0 ? (
      <p class="text-[color:var(--color-ink-muted)]">No essays published yet.</p>
    ) : (
      <div>
        {essays.map((essay) => {
          const { minutes } = readingTime(essay.body);
          return (
            <EssayCard
              title={essay.data.title}
              description={essay.data.description}
              pubDate={essay.data.pubDate}
              href={`/writing/${essay.id}/`}
              tags={essay.data.tags}
              readingMinutes={minutes}
              featured={essay.data.featured}
            />
          );
        })}
      </div>
    )
  }
</BaseLayout>
