---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  role?: string;
  stack?: string[];
  link?: string;
  repo?: string;
}

const { title, description, role, stack = [], link, repo } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8">
      <a href="/projects" class="text-[14px] text-[color:var(--color-ink-muted)] font-mono no-underline hover:no-underline hover:text-[color:var(--color-ink)]">← projects</a>
      <h1 class="mt-3 text-[34px] font-semibold tracking-tight leading-tight">{title}</h1>
      {role && <p class="mt-2 text-[14px] text-[color:var(--color-ink-muted)] font-mono">{role}</p>}
      <p class="mt-3 text-[17px] text-[color:var(--color-ink-muted)]">{description}</p>

      {
        stack.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
            {stack.map((tech) => (
              <span class="text-[12px] text-[color:var(--color-ink-faint)] font-mono">{tech}</span>
            ))}
          </div>
        )
      }

      {
        (link || repo) && (
          <div class="mt-4 flex flex-wrap gap-4 text-[14px] font-mono">
            {link && (
              <a href={link} target="_blank" rel="noopener noreferrer">site ↗</a>
            )}
            {repo && (
              <a href={repo} target="_blank" rel="noopener noreferrer">repo ↗</a>
            )}
          </div>
        )
      }
    </header>

    <div class="prose-essay">
      <slot />
    </div>
  </article>
</BaseLayout>
